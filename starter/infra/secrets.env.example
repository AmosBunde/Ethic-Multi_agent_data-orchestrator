# Copy to secrets.env (git-ignored) and fill in. Each variable maps to a Key Vault
# secret of the same name with underscores replaced by hyphens and lower-cased,
# e.g. POSTGRES_HOST -> postgres-host.

# --- Azure OpenAI / AI Foundry (shared by structured and unstructured agents)
#     Deployments required: gpt-4.1-mini and text-embedding-ada-002
AI_ENDPOINT="https://<your-foundry-resource>.openai.azure.com/"
AI_KEY=""

# --- Azure Database for PostgreSQL Flexible Server (structured agent)
POSTGRES_HOST="<server>.postgres.database.azure.com"
POSTGRES_DATABASE="postgres"
POSTGRES_USER=""
POSTGRES_PASSWORD=""

# --- Azure Cosmos DB for MongoDB vCore (unstructured agent). Collection is fixed to "permits".
MONGODB_CONNECTION_STRING="mongodb+srv://<user>:<password>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000"
MONGODB_DATABASE="documents"

# --- Azure Blob Storage, container "houses" (multimodal agent)
BLOB_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"

# --- Azure AI Content Safety (multimodal agent)
CONTENT_SAFETY_ENDPOINT="https://<your-contentsafety-resource>.cognitiveservices.azure.com/"
CONTENT_SAFETY_KEY=""
